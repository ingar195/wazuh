<group name="teamviewer,">

    <rule id="223101" level="8">
        <decoded_as>tv_logon</decoded_as>
        <field name="remote_id" type="pcre2">(.*?)</field>

        <description>TV: Connection from ID: $(remote_id), Name: $(remote_name)</description>
    </rule>

    <rule id="223102" level="12" ignore="5">
        <decoded_as>tv_failed_logon</decoded_as>
        <field name="remote_id" type="pcre2">(.*?)</field>
        <description>TV: Failed login attempt from $(remote_id)</description>
    </rule>

</group>