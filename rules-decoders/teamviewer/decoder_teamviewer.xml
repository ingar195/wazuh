<!-- Get id for failed login -->
 <decoder name="tv_failed_logon">
    <prematch>AuthenticationBlocker</prematch>
</decoder>
<decoder name="tv_failed_logon_id_decoder">
    <parent>tv_failed_logon</parent>
     <regex offset="after_parent" type="pcre2">DyngateID\s(\d+),\sattempt number\s(\d$)</regex>
    <order>remote_id</order>
</decoder>


<!-- Get id for successful login -->
<!-- 2026/03/07 17:11:25.994  5944       7552 S0   CPersistentParticipantManager::AddParticipant: [123123123,-12312312312] type=6 name=Some Name -->
<decoder name="tv_logon">
    <prematch>CPersistentParticipantManager</prematch>
</decoder>
<decoder name="tv_authentication_get_id_decoder">
    <parent>tv_logon</parent>
    <regex offset="after_parent" type="pcre2">AddParticipant:\s\[(\d+),-\d+\]\stype=\d\sname=(.*?$)</regex>
    <order>remote_id,remote_name</order>
</decoder>