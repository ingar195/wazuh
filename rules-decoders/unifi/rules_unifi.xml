<group name="unifi,">

    <rule id="222300" level="3">
        <decoded_as>unifi_event</decoded_as>
        <description>UniFi Event: $(unifi_event_title) - $(unifi_event_msg)</description>
    </rule>
    
    <rule id="222301" level="16">
        <if_sid>222300</if_sid>
        <field name="unifi_event_id" type="pcre2">^(545|549)$</field>
        <field name="unifi_setting_type" type="pcre2">^Port forwarding$</field>
        <description>UniFi Port Forwarding Changed: $(unifi_event_msg)</description>
    </rule>

    <rule id="222311" level="12">
        <if_sid>222300</if_sid>
        <field name="unifi_event_id" type="pcre2">^(545|547|548|549)$</field>
        <field name="unifi_setting_type" type="pcre2">^Firewall Policy$</field>
        <description>UniFi Firewall Policy Changed: $(unifi_event_msg)</description>
    </rule>

    <rule id="222341" level="8">
        <if_sid>222300</if_sid>
        <field name="unifi_event_id" type="pcre2">^544$</field>
        <description>UniFi Admin Access: $(unifi_event_msg)</description>
    </rule>

    <rule id="222361" level="2">
        <if_sid>222300</if_sid>
        <field name="unifi_event_id" type="pcre2">^(400|401|402|403|404)$</field>
        <description>UniFi Device Connection: $(unifi_event_msg)</description>
    </rule>

</group>