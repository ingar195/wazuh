<decoder name="unifi_event">
    <program_name>^CEF</program_name>
    <prematch type="pcre2">\|Ubiquiti\|UniFi Network\|</prematch>
</decoder>

<decoder name="unifi_event">
    <prematch type="pcre2">CEF:\d+\|Ubiquiti\|UniFi Network\|</prematch>
</decoder>

<decoder name="unifi_event_type">
    <parent>unifi_event</parent>
    <regex offset="after_parent" type="pcre2">^([\d\.]+)\|(\d+)\|(.*?)\|</regex>
    <order>unifi_version, unifi_event_id, unifi_event_title</order>
</decoder>

<decoder name="unifi_event_type">
    <parent>unifi_event</parent>
    <regex offset="after_parent" type="pcre2">UNIFIcategory=(\w+)</regex>
    <order>unifi_category</order>
</decoder>

<decoder name="unifi_event_type">
    <parent>unifi_event</parent>
    <regex offset="after_parent" type="pcre2">UNIFIhost=(.*?)\s+UNIFI</regex>
    <order>unifi_unifi_host</order>
</decoder>

<decoder name="unifi_event_type">
    <parent>unifi_event</parent>
    <regex offset="after_parent" type="pcre2">UNIFIsettingsSection=(.*?)\s+UNIFIsettingsEntry</regex>
    <order>unifi_setting_type</order>
</decoder>

<decoder name="unifi_event_type">
    <parent>unifi_event</parent>
    <regex offset="after_parent" type="pcre2">src=(\d+\.\d+\.\d+\.\d+)</regex>
    <order>srcip</order>
</decoder>

<decoder name="unifi_event_type">
    <parent>unifi_event</parent>
    <regex offset="after_parent" type="pcre2">msg=(.*)$</regex>
    <order>unifi_event_msg</order>
</decoder>

<!-- Get Admin name -->
<decoder name="unifi_event_type">
    <parent>unifi_event</parent>
    <regex offset="after_parent" type="pcre2">UNIFIadmin=(.*?)\scnt</regex>
    <order>unifi_admin</order>
</decoder>

<decoder name="unifi_event_type">
    <parent>unifi_event</parent>
    <regex offset="after_parent" type="pcre2">use_fixedip:\s(\w+);</regex>
    <order>unifi_fixedip</order>
</decoder>

<decoder name="unifi_event_type">
    <parent>unifi_event</parent>
    <regex offset="after_parent" type="pcre2">fixed_ip:\s(\d+.\d+.\d+.\d+)\s</regex>
    <order>unifi_fixedip_ip</order>
</decoder>

<decoder name="unifi_event_type">
    <parent>unifi_event</parent>
    <regex offset="after_parent" type="pcre2">UNIFIsettingsChanges=name:\s(.*?);</regex>
    <order>unifi_settings_name</order>
</decoder>

<decoder name="unifi_event_type">
    <parent>unifi_event</parent>
    <regex offset="after_parent" type="pcre2">UNIFIapplicationVersion=(.*?)\s</regex>
    <order>unifi_updated_application_version</order>
</decoder>

<decoder name="unifi_event_type">
    <parent>unifi_event</parent>
    <regex offset="after_parent" type="pcre2">UNIFIapplicationPriorVersion=(.*?)\s</regex>
    <order>unifi_prior_application_version</order>
</decoder>

<decoder name="unifi_event_type">
    <parent>unifi_event</parent>
    <regex offset="after_parent" type="pcre2">UNIFIdeviceList=(.*?)\scnt=</regex>
    <order>unifi_device_list</order>
</decoder>
