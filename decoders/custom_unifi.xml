    <parent>unifi_event</parent>
    <regex offset="after_parent" type="pcre2">UNIFIadmin=(.*) cnt</regex>
    <order>admin_name</order>
</decoder> -->

<decoder name="unifi_event_type">
    <parent>unifi_event</parent>
    <regex offset="after_parent" type="pcre2">msg=(.*)</regex>
    <order>event_msg</order>
</decoder>